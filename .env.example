# Copy to .env and fill in. Never commit .env.
# Generate a key: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-strong-random-key

# Production default is False. Set True only for local development.
DJANGO_DEBUG=False

# SMTP relay for outgoing email (ask IT for the company relay host)
DJANGO_EMAIL_HOST=localhost
DJANGO_EMAIL_PORT=25

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,<SERVER_IP_OR_HOSTNAME>
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://<SERVER_IP_OR_HOSTNAME>

# Set True only once Caddy serves HTTPS with a certificate
DJANGO_HTTPS=False
